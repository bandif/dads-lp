---
import { practice } from "../data/practice";
import copy from "../content/site/peniszgorbulet.json";
import { inlineText } from "../data/inline-text";
import MedicalEditorial from "../components/MedicalEditorial.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
---
<Layout title="Péniszgörbület kezelése | Dr. Fekete Ferenc" description="Ha a pénisz görbülete akadályozza a nemi életet: vizsgálat, műtéti lehetőségek, várható eredmények és felépülés, közérthetően.">
  <Header />
  <main>
    <section class="condition-hero">
      <div class="container">
        <a class="text-link" href="/#problemak-title">{copy.section1.button1}</a>
        <p class="eyebrow">{copy.section1.eyebrow1}</p>
        <h1>{copy.section1.heading1}</h1>
        <p class="condition-lead">{copy.section1.paragraph1}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#kapcsolat">{copy.section1.button2}</a>
          <a class="button button-secondary" href="#video">{copy.section1.button3}</a>
        </div>
      </div>
    </section>
    <div class="container condition-layout">
      <aside class="condition-nav" aria-label="Az oldal tartalma">
        <p class="eyebrow">{copy.section2.eyebrow1}</p>
        <a href="#attekintes">{copy.section2.button1}</a>
        <a href="#kezeles">{copy.section2.button2}</a>
        <a href="#mutet">{copy.section2.button3}</a>
        <a href="#felepules">{copy.section2.button4}</a>
        <a href="#konzultacio">{copy.section2.button5}</a>
          <a href="#video">{copy.section2.button6}</a>
      </aside>
      <div class="condition-content">
        <section id="attekintes" aria-labelledby="attekintes-title">
          <p class="eyebrow">{copy.attekintes.eyebrow1}</p>
          <h2 id="attekintes-title">{copy.attekintes.heading1}</h2>
          <p>{copy.attekintes.paragraph1}</p>
        </section>

        <section id="kezeles" aria-labelledby="kezeles-title">
          <p class="eyebrow">{copy.kezeles.eyebrow1}</p>
          <h2 id="kezeles-title">{copy.kezeles.heading1}</h2>
          <p>{copy.kezeles.paragraph1}</p>
          <p><Fragment set:html={inlineText(copy.kezeles.paragraph2)} /></p>
          <p>{copy.kezeles.paragraph3}</p>
          <div class="treatment-note">
            <h3>{copy.kezeles.heading2}</h3>
            <p>{copy.kezeles.paragraph4}</p>
          </div>
        </section>

        <section id="mutet" aria-labelledby="mutet-title">
          <p class="eyebrow">{copy.mutet.eyebrow1}</p>
          <h2 id="mutet-title">{copy.mutet.heading1}</h2>
          <p>{copy.mutet.paragraph1}</p>
          <p><Fragment set:html={inlineText(copy.mutet.paragraph2)} /></p>
          <p>{copy.mutet.paragraph3}</p>
          <p>{copy.mutet.paragraph4}</p>
        </section>

        <section id="felepules" aria-labelledby="felepules-title">
          <p class="eyebrow">{copy.felepules.eyebrow1}</p>
          <h2 id="felepules-title">{copy.felepules.heading1}</h2>
          <p>{copy.felepules.paragraph1}</p>
          <p>{copy.felepules.paragraph2}</p>
          <div class="treatment-note">
            <h3>{copy.felepules.heading2}</h3>
            <p>{copy.felepules.paragraph3}</p>
          </div>
        </section>

        <section id="konzultacio" aria-labelledby="konzultacio-title">
          <p class="eyebrow">{copy.konzultacio.eyebrow1}</p>
          <h2 id="konzultacio-title">{copy.konzultacio.heading1}</h2>
          <p>{copy.konzultacio.paragraph1}</p>
          <p>{copy.konzultacio.paragraph2}</p>
          <a class="text-link" href={`mailto:${practice.email}`}>{copy.konzultacio.button1}</a>
        </section>
        <section id="video" aria-labelledby="video-title">
          <p class="eyebrow">{copy.video.eyebrow1}</p>
          <h2 id="video-title">{copy.video.heading1}</h2>
          <p>{copy.video.paragraph1}</p>
          <div class="treatment-note">
            <h3>{copy.video.heading2}</h3>
            <ul><li>{copy.video.text1}</li><li>{copy.video.text2}</li><li>{copy.video.text3}</li></ul>
          </div>
          <div class="video-embed">
            <iframe
              src="https://www.youtube-nocookie.com/embed/e8p4opFKwx0"
              title="Péniszgörbület – Dr. Fekete Ferenc videós tájékoztatója"
              width="560"
              height="315"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="video-link"><a class="text-link" href="https://www.youtube.com/watch?v=e8p4opFKwx0" target="_blank" rel="noopener noreferrer">{copy.video.button1}</a></p>
        </section>
        <MedicalEditorial />

      </div>
    </div>
    <ContactCTA />
  </main>
  <Footer />
</Layout>
