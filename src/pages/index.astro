---
import Layout from "../layouts/Layout.astro";
import AboutDoctor from "../components/AboutDoctor.astro";
import ContactCTA from "../components/ContactCTA.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Testimonials from "../components/Testimonials.astro";
import WhyChooseDoctor from "../components/WhyChooseDoctor.astro";
import ProblemCards from "../components/ProblemCards.astro";
import Process from "../components/Process.astro";

const title = "Dr. Fekete Ferenc urológus | Magánrendelés Budapesten";
const description =
  "Dr. Fekete Ferenc urológus több mint 30 éves műtéti tapasztalattal. Szakterületek, bemutatkozás és időpontkérés a budapesti, Kapás utcai magánrendelésre.";
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <ProblemCards />
    <Testimonials />
    <AboutDoctor />
    <WhyChooseDoctor />
    <Process />
    <FAQ />
    <ContactCTA />
  </main>
  <Footer />
</Layout>
