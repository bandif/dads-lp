---
import copy from "../content/site/dr-fekete-ferenc.json";
import { inlineText } from "../data/inline-text";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
---
<Layout title="Dr. Fekete Ferenc – szakmai bemutatkozás" description="Dr. Fekete Ferenc urológus szakorvos szakmai pályája, műtéti tapasztalata, oktatói munkája és könyvei.">
  <Header />
  <main>
    <section class="section section-soft">
      <div class="container doctor-grid">
        <div class="doctor-photo">
          <img src={copy.section1.image1} alt="Dr. Fekete Ferenc műtéti környezetben" width="1280" height="960" />
        </div>
        <div class="doctor-copy">
          <a class="text-link" href="/#orvos">{copy.section1.button1}</a>
          <p class="eyebrow profile-eyebrow">{copy.section1.eyebrow1}</p>
          <h1>{copy.section1.heading1}</h1>
          <p class="subheading">{copy.section1.paragraph1}</p>
          <p class="condition-lead">{copy.section1.paragraph2}</p>
          <a class="button button-primary" href="#kapcsolat">{copy.section1.button2}</a>
        </div>
      </div>
    </section>
    <div class="container condition-layout">
      <aside class="condition-nav" aria-label="Az oldal tartalma">
        <p class="eyebrow">{copy.section2.eyebrow1}</p>
        <a href="#palyafutas">{copy.section2.button1}</a>
        <a href="#tapasztalat">{copy.section2.button2}</a>
        <a href="#oktatas">{copy.section2.button3}</a>
        <a href="#konyvek">{copy.section2.button4}</a>
      </aside>
      <div class="condition-content">
        <section id="palyafutas" aria-labelledby="palyafutas-title">
          <p class="eyebrow">{copy.palyafutas.eyebrow1}</p>
          <h2 id="palyafutas-title">{copy.palyafutas.heading1}</h2>
          <p><Fragment set:html={inlineText(copy.palyafutas.paragraph1)} /></p>
          <p>{copy.palyafutas.paragraph2}</p>
          <p>{copy.palyafutas.paragraph3}</p>
          <p><Fragment set:html={inlineText(copy.palyafutas.paragraph4)} /></p>
        </section>
        <section id="tapasztalat" aria-labelledby="tapasztalat-title">
          <p class="eyebrow">{copy.tapasztalat.eyebrow1}</p>
          <h2 id="tapasztalat-title">{copy.tapasztalat.heading1}</h2>
          <p>{copy.tapasztalat.paragraph1}</p>
          <p>{copy.tapasztalat.paragraph2}</p>
          <p>{copy.tapasztalat.paragraph3}</p>
          <p>{copy.tapasztalat.paragraph4}</p>
        </section>
        <section id="oktatas" aria-labelledby="oktatas-title">
          <p class="eyebrow">{copy.oktatas.eyebrow1}</p>
          <h2 id="oktatas-title">{copy.oktatas.heading1}</h2>
          <p><Fragment set:html={inlineText(copy.oktatas.paragraph1)} /></p>
          <p>{copy.oktatas.paragraph2}</p>
        </section>
        <section id="konyvek" aria-labelledby="konyvek-title">
          <p class="eyebrow">{copy.konyvek.eyebrow1}</p>
          <h2 id="konyvek-title">{copy.konyvek.heading1}</h2>
          <p><Fragment set:html={inlineText(copy.konyvek.paragraph1)} /></p>
          <div class="profile-books">
            <figure class="profile-book">
              <div class="profile-book-cover"><img src={copy.konyvek.image1} alt="Fekete Ferenc: Erekciós zavarok – könyvborító" width="225" height="300" loading="lazy" /></div>
              <figcaption><h3>{copy.konyvek.heading2}</h3><p>{copy.konyvek.paragraph2}</p></figcaption>
            </figure>
            <figure class="profile-book">
              <div class="profile-book-cover"><img src={copy.konyvek.image2} alt="Dr. Romics Imre és Dr. Fekete Ferenc: Urológia mindenkinek – könyvborító" width="249" height="300" loading="lazy" /></div>
              <figcaption><h3>{copy.konyvek.heading3}</h3><p>{copy.konyvek.paragraph3}</p></figcaption>
            </figure>
          </div>
        </section>
      </div>
    </div>
    <ContactCTA />
  </main>
  <Footer />
</Layout>
