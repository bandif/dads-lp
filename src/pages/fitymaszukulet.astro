---
import copy from "../content/site/fitymaszukulet.json";
import { inlineText } from "../data/inline-text";
import MedicalEditorial from "../components/MedicalEditorial.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
---
<Layout title="Fitymaszűkület és rövid fék | Dr. Fekete Ferenc" description="Fitymaszűkület és rövid fék: a panaszok okai, kezelési lehetőségek és a műtét utáni tudnivalók, közérthetően.">
  <Header />
  <main>
    <section class="condition-hero">
      <div class="container">
        <a class="text-link" href="/#problemak-title">{copy.section1.button1}</a>
        <p class="eyebrow">{copy.section1.eyebrow1}</p>
        <h1>{copy.section1.heading1}</h1>
        <p class="condition-lead">{copy.section1.paragraph1}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#kapcsolat">{copy.section1.button2}</a>
          <a class="button button-secondary" href="#video">{copy.section1.button3}</a>
        </div>
      </div>
    </section>
    <div class="container condition-layout">
  <aside class="condition-nav" aria-label="Az oldal tartalma">
    <p class="eyebrow">{copy.section2.eyebrow1}</p>
        <a href="#attekintes">{copy.section2.button1}</a>
    <a href="#tunetek">{copy.section2.button2}</a>
    <a href="#kezeles">{copy.section2.button3}</a>
    <a href="#felepules">{copy.section2.button4}</a>
      <a href="#video">{copy.section2.button5}</a>
      </aside>
  <div class="condition-content">
        <section id="attekintes" aria-labelledby="attekintes-title">
          <p class="eyebrow">{copy.attekintes.eyebrow1}</p>
          <h2 id="attekintes-title">{copy.attekintes.heading1}</h2>
          <p>{copy.attekintes.paragraph1}</p>
        </section>

    <section id="tunetek" aria-labelledby="tunetek-title">
      <p class="eyebrow">{copy.tunetek.eyebrow1}</p>
      <h2 id="tunetek-title">{copy.tunetek.heading1}</h2>
      <p><Fragment set:html={inlineText(copy.tunetek.paragraph1)} /></p>
      <p><Fragment set:html={inlineText(copy.tunetek.paragraph2)} /></p>
      <p>{copy.tunetek.paragraph3}</p>
      <div class="urgent-note">
        <h3>{copy.tunetek.heading2}</h3>
        <p><Fragment set:html={inlineText(copy.tunetek.paragraph4)} /></p>
      </div>
    </section>
    <section id="kezeles" aria-labelledby="kezeles-title">
      <p class="eyebrow">{copy.kezeles.eyebrow1}</p>
      <h2 id="kezeles-title">{copy.kezeles.heading1}</h2>
      <p>{copy.kezeles.paragraph1}</p>
      <p><Fragment set:html={inlineText(copy.kezeles.paragraph2)} /></p>
      <p>{copy.kezeles.paragraph3}</p>
      <div class="treatment-note">
        <h3>{copy.kezeles.heading2}</h3>
        <p>{copy.kezeles.paragraph4}</p>
      </div>
    </section>
    <section id="felepules" aria-labelledby="felepules-title">
      <p class="eyebrow">{copy.felepules.eyebrow1}</p>
      <h2 id="felepules-title">{copy.felepules.heading1}</h2>
      <p>{copy.felepules.paragraph1}</p>
      <p>{copy.felepules.paragraph2}</p>
      <h3>{copy.felepules.heading2}</h3>
      <p>{copy.felepules.paragraph3}</p>
      <h3>{copy.felepules.heading3}</h3>
      <p>{copy.felepules.paragraph4}</p>
      <p>{copy.felepules.paragraph5}</p>
      <a class="text-link" href="/#gyakori-kerdesek">{copy.felepules.button1}</a>
    </section>
    <section id="video" aria-labelledby="video-title">
      <p class="eyebrow">{copy.video.eyebrow1}</p>
      <h2 id="video-title">{copy.video.heading1}</h2>
      <p>{copy.video.paragraph1}</p>
          <div class="treatment-note">
            <h3>{copy.video.heading2}</h3>
            <ul><li>{copy.video.text1}</li><li>{copy.video.text2}</li><li>{copy.video.text3}</li></ul>
          </div>
          <div class="video-embed">
        <iframe
          src="https://www.youtube-nocookie.com/embed/UEbbOcyX3EY"
          title="Fitymaszűkület – Dr. Fekete Ferenc videós tájékoztatója"
          width="560"
          height="315"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <p class="video-link"><a class="text-link" href="https://www.youtube.com/watch?v=UEbbOcyX3EY" target="_blank" rel="noopener noreferrer">{copy.video.button1}</a></p>
    </section>
        <MedicalEditorial />

  </div>
</div>
    <ContactCTA />
  </main>
  <Footer />
</Layout>
