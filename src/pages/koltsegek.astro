---
import copy from "../content/site/koltsegek.json";
import { practice } from "../data/practice";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
---
<Layout title={`${copy.heading} | Dr. Fekete Ferenc`} description="Vizsgálati és műtéti díjak: fitymaszűkület, rövid fitymafék, papulák, péniszgörbület és implantátum. Tudnivalók az árakról és az utókezelésről.">
  <Header />
  <main>
    <section class="condition-hero">
      <div class="container">
        <h1>{copy.heading}</h1>
        <p class="condition-lead">{copy.lead}</p>
      </div>
    </section>
    <div class="container costs-content">
      <section aria-labelledby="included-title" class="costs-intro">
        <h2 id="included-title">{copy.introHeading}</h2>
        {copy.intro.map(paragraph => <p>{paragraph}</p>)}
      </section>
      <section aria-labelledby="prices-title">
        <h2 id="prices-title">{copy.pricesHeading}</h2>
        <dl class="price-list">
          {copy.treatments.map(treatment => (
            <div class="price-row">
              <dt>{treatment.name}</dt>
              <dd class="price">{treatment.price}</dd>
              {treatment.note && <dd class="price-note">{treatment.note}</dd>}
            </div>
          ))}
        </dl>
        <p class="treatment-note"><strong>{copy.notice}</strong></p>
      </section>
      <section aria-labelledby="questions-title" class="costs-intro">
        <h2 id="questions-title">{copy.questionHeading}</h2>
        <p>{copy.questionText}</p>
        <a class="text-link" href={`mailto:${practice.email}`}>{practice.email}</a>
      </section>
    </div>
    <ContactCTA />
  </main>
  <Footer />
</Layout>

<style>
  .costs-content { max-width: 1000px; padding-block: clamp(3rem, 6vw, 5rem); }
  .costs-content section + section { margin-top: 3.5rem; }
  .costs-content h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .costs-intro { max-width: 74ch; }
  .price-list { margin: 1.5rem 0 0; }
  .price-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 2rem; padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .price-row:last-child { border-bottom: 1px solid var(--line); }
  dt { font-weight: 750; line-height: 1.5; }
  dd { margin: 0; }
  .price { color: var(--accent-dark); font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .price-note { grid-column: 1 / -1; max-width: 74ch; margin-top: 0.5rem; color: var(--muted); }
  @media (max-width: 600px) {
    .price-row { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
    .price-note { margin-top: 0; }
  }
</style>
