---
import copy from "../content/site/papulak.json";
import { inlineText } from "../data/inline-text";
import MedicalEditorial from "../components/MedicalEditorial.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
---
<Layout title="Papulák a makk peremén | Dr. Fekete Ferenc" description="Mik azok a gyöngyházfényű papulák, és mikor érdemes kezelést választani? Közérthető tájékoztató, videó és tudnivalók a beavatkozásról.">
  <Header />
  <main>
    <section class="condition-hero">
      <div class="container">
        <a class="text-link" href="/#problemak-title">{copy.section1.button1}</a>
        <p class="eyebrow">{copy.section1.eyebrow1}</p>
        <h1>{copy.section1.heading1}</h1>
        <p class="condition-lead">{copy.section1.paragraph1}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#kapcsolat">{copy.section1.button2}</a>
          <a class="button button-secondary" href="#video">{copy.section1.button3}</a>
        </div>
      </div>
    </section>
    <div class="container condition-layout">
      <aside class="condition-nav" aria-label="Az oldal tartalma">
        <p class="eyebrow">{copy.section2.eyebrow1}</p>
        <a href="#attekintes">{copy.section2.button1}</a>
        <a href="#papulak">{copy.section2.button2}</a>
        <a href="#kezeles">{copy.section2.button3}</a>
        <a href="#beavatkozas">{copy.section2.button4}</a>
        <a href="#gyogyulas">{copy.section2.button5}</a>
          <a href="#video">{copy.section2.button6}</a>
      </aside>
      <div class="condition-content">
        <section id="attekintes" aria-labelledby="attekintes-title">
          <p class="eyebrow">{copy.attekintes.eyebrow1}</p>
          <h2 id="attekintes-title">{copy.attekintes.heading1}</h2>
          <p>{copy.attekintes.paragraph1}</p>
        </section>

        <section id="papulak" aria-labelledby="papulak-title">
          <p class="eyebrow">{copy.papulak.eyebrow1}</p>
          <h2 id="papulak-title">{copy.papulak.heading1}</h2>
          <p>{copy.papulak.paragraph1}</p>
          <div class="treatment-note">
            <h3>{copy.papulak.heading2}</h3>
            <p><Fragment set:html={inlineText(copy.papulak.paragraph2)} /></p>
          </div>
          <p>{copy.papulak.paragraph3}</p>
        </section>

        <section id="kezeles" aria-labelledby="kezeles-title">
          <p class="eyebrow">{copy.kezeles.eyebrow1}</p>
          <h2 id="kezeles-title">{copy.kezeles.heading1}</h2>
          <p><Fragment set:html={inlineText(copy.kezeles.paragraph1)} /></p>
          <p>{copy.kezeles.paragraph2}</p>
          <p>{copy.kezeles.paragraph3}</p>
        </section>

        <section id="beavatkozas" aria-labelledby="beavatkozas-title">
          <p class="eyebrow">{copy.beavatkozas.eyebrow1}</p>
          <h2 id="beavatkozas-title">{copy.beavatkozas.heading1}</h2>
          <p>{copy.beavatkozas.paragraph1}</p>
          <p>{copy.beavatkozas.paragraph2}</p>
          <p><Fragment set:html={inlineText(copy.beavatkozas.paragraph3)} /></p>
          <p>{copy.beavatkozas.paragraph4}</p>
        </section>

        <section id="gyogyulas" aria-labelledby="gyogyulas-title">
          <p class="eyebrow">{copy.gyogyulas.eyebrow1}</p>
          <h2 id="gyogyulas-title">{copy.gyogyulas.heading1}</h2>
          <p>{copy.gyogyulas.paragraph1}</p>
          <p><Fragment set:html={inlineText(copy.gyogyulas.paragraph2)} /></p>
          <p>{copy.gyogyulas.paragraph3}</p>
        </section>
        <section id="video" aria-labelledby="video-title">
          <p class="eyebrow">{copy.video.eyebrow1}</p>
          <h2 id="video-title">{copy.video.heading1}</h2>
          <p>{copy.video.paragraph1}</p>
          <div class="treatment-note">
            <h3>{copy.video.heading2}</h3>
            <ul><li>{copy.video.text1}</li><li>{copy.video.text2}</li><li>{copy.video.text3}</li></ul>
          </div>
          <div class="video-embed">
            <iframe
              src="https://www.youtube-nocookie.com/embed/a9DvxYzAJp8?start=11"
              title="Papulák a makk peremén – Dr. Fekete Ferenc videós tájékoztatója"
              width="560"
              height="315"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="video-link"><a class="text-link" href="https://www.youtube.com/watch?v=a9DvxYzAJp8&amp;t=11s" target="_blank" rel="noopener noreferrer">{copy.video.button1}</a></p>
        </section>
        <MedicalEditorial />

      </div>
    </div>
    <ContactCTA />
  </main>
  <Footer />
</Layout>
