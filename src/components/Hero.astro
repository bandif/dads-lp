---
import reviews from "../content/site/Testimonials.json";
import copy from "../content/site/Hero.json";
import { inlineText } from "../data/inline-text";
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{copy.section1.eyebrow1}</p>
      <h1>{copy.section1.heading1}</h1>
      <p class="hero-lead"><Fragment set:html={inlineText(copy.section1.paragraph1)} /></p>
      <div class="hero-actions">
        <a class="button button-primary" href="#kapcsolat">{copy.section1.button1}</a>
      </div>
      <a class="hero-review-link" href="#velemenyek" aria-label={`${reviews.rating.score}${reviews.rating.scale}, ${reviews.rating.shortLabel}`}>
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <span><strong>{reviews.rating.score}</strong> · {reviews.rating.shortLabel}</span>
      </a>
    </div>

    <div class="hero-visual" aria-label="Dr. Fekete Ferenc rendelői környezetben">
      <div class="hero-photo">
        <img
          src={copy.section1.image1}
          alt="Dr. Fekete Ferenc urológus szakorvos rendelői környezetben"
          width="1239"
          height="772"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
