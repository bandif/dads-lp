---
import copy from "../content/site/MedicalEditorial.json";
import { medicalContent } from "../data/medical-content";
import { practice } from "../data/practice";
const path = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const content = medicalContent[path];
const formatDate = (date: string) => new Intl.DateTimeFormat("hu-HU", {
  year: "numeric", month: "long", day: "numeric", timeZone: "Europe/Berlin",
}).format(new Date(`${date}T12:00:00Z`));
---
{content && (
  <aside class="medical-editorial" aria-label="Szakorvos és tartalmi háttér">
    <p>{copy.content.text1} <a class="text-link" href={practice.profilePath}>{practice.name}{copy.content.text2}</a></p>
    <p>{copy.content.text3} <time datetime={content.updated}>{formatDate(content.updated)}</time></p>
    {content.reviewedOn && <p>{copy.content.text4} <a href={practice.profilePath}>{practice.name}</a> · <time datetime={content.reviewedOn}>{formatDate(content.reviewedOn)}</time></p>}
    <p>{copy.content.paragraph1}</p>
    <details>
      <summary>{copy.content.text5}</summary>
      <ul>{content.sources.map(source => <li><a class="text-link" href={source.url}>{source.name} {copy.content.text6}</a></li>)}</ul>
    </details>
  </aside>
)}
