---
import { practice } from "../data/practice";
const contacts = [
  { label: "Telefon", value: practice.phone, href: practice.phoneHref },
  { label: "E-mail", value: practice.email, href: `mailto:${practice.email}` },
  { label: "Rendelő", value: practice.address, href: practice.mapUrl },
];
---

<section class="section contact-section" id="kapcsolat" aria-labelledby="contact-title">
  <div class="container contact-panel">
    <div>
      <p class="eyebrow">Kapcsolat</p>
      <h2 id="contact-title">Kérjen időpontot</h2>
      <p>
        Ha fitymaszűkülettel, rövid fékkel vagy kapcsolódó problémával kapcsolatban
        szeretne segítséget kérni, keressen bizalommal.
      </p>
      <div class="contact-actions">
        <a class="button button-primary" href={practice.phoneHref}>Telefonálok</a>
        <a class="button button-light" href={`mailto:${practice.email}`}>E-mailt írok</a>
      </div>
      <p class="contact-hours">Rendelés: {practice.officeHours}.</p>
    </div>
    <address class="contact-list">
      {contacts.map((contact) => (
        <a href={contact.href}>
          <span>{contact.label}</span>
          <strong>{contact.value}</strong>
        </a>
      ))}
    </address>
  </div>
</section>

<div class="mobile-contact-bar" aria-label="Gyors kapcsolatfelvétel">
  <a href={practice.phoneHref}>Telefonálok</a>
  <a href="#kapcsolat">Időpont</a>
</div>
