---
import copy from "../content/site/AboutDoctor.json";
const credentials = copy.credentials;
---

<section class="section" id="orvos" aria-labelledby="doctor-title">
  <div class="container doctor-grid">
    <div class="doctor-photo">
      <img
        src={copy.orvos.image1}
        alt="Dr. Fekete Ferenc műtéti környezetben"
        width="1280"
        height="960"
        loading="lazy"
      />
    </div>
    <div class="doctor-copy">
      <p class="eyebrow">{copy.orvos.eyebrow1}</p>
      <h2 id="doctor-title">{copy.orvos.heading1}</h2>
      <p class="subheading">{copy.orvos.paragraph1}</p>
      <p>{copy.orvos.paragraph2}</p>
      <ul class="credential-list">
        {credentials.map((credential) => <li>{credential}</li>)}
      </ul>
      <a class="button button-secondary" href="/dr-fekete-ferenc/">{copy.orvos.button1}</a>
    </div>
  </div>
</section>
