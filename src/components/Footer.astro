---
import copy from "../content/site/Footer.json";
import { practice } from "../data/practice";
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <strong>{copy.content.text1}</strong>
      <span>{copy.content.text2}</span>
    </div>
    <address>
      <a href={practice.phoneHref}>{practice.phone}</a>
      <a href={`mailto:${practice.email}`}>{practice.email}</a>
      <span>{practice.address}</span>
    </address>
    <small>© {new Date().getFullYear()} {copy.content.text3}</small>
  </div>
</footer>
