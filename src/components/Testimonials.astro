---
import copy from "../content/site/Testimonials.json";
// Rating and count transcribed from the owner's supplied Google listing screenshot.
// Owner-supplied link to the listing's reviews view.
const googleUrl = "https://www.google.com/maps/search/?api=1&query=Dr.%20Fekete%20Ferenc%20Budapest%20Kap%C3%A1s%20utca%2026";
// Review text and first-name attributions supplied by the owner.
const reviews = copy.reviews;
---
<section id="velemenyek" class="reviews-section" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews-heading">
      <div>
        <p class="eyebrow">{copy.velemenyek.eyebrow1}</p>
        <h2 id="reviews-title">{copy.velemenyek.heading1}</h2>
        <a class="text-link" href={googleUrl} target="_blank" rel="noopener noreferrer">{copy.velemenyek.text1} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="reviews-rating" aria-label={`${copy.rating.score}${copy.rating.scale}, ${copy.velemenyek.paragraph1}`}>
        <strong>{copy.rating.score}<span>{copy.rating.scale}</span></strong>
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <p>{copy.velemenyek.paragraph1}</p>
      </div>
    </div>
    {reviews.length > 0 && (
      <div class="reviews-grid">
        {reviews.slice(0, 3).map((review) => (
          <figure class="review-card">
            <span class="review-stars" aria-label="5 csillag az 5-ből">★★★★★</span>
            <blockquote><p>{review.text}</p></blockquote>
            <figcaption><strong>{review.name}</strong></figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>
