---
import copy from "../content/site/Process.json";
const steps = copy.steps;
---

<section class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{copy.section1.eyebrow1}</p>
      <h2 id="process-title">{copy.section1.heading1}</h2>
    </div>
    <ol class="process-grid">
      {steps.map((step, index) => (
        <li>
          <span>{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          {index === 0 && <a class="button button-primary" href="#kapcsolat">{copy.section1.button1}</a>}
        </li>
      ))}
    </ol>
  </div>
</section>
