---
import copy from "../content/site/Header.json";
import { practice } from "../data/practice";
const navItemsLayout = [
  {
    "href": "/fitymaszukulet/"
  },
  {
    "href": "/dr-fekete-ferenc/"
  },
  {
    "href": "/#gyakori-kerdesek"
  },
  {
    "href": "#kapcsolat"
  },
  {
    "href": "/koltsegek/"
  }
];
const navItems = Object.values(copy.navItems).map((item, index) => ({ ...item, ...navItemsLayout[index] }));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Dr. Fekete Ferenc főoldal">
      <span>{copy.content.text1}</span>
      <small>{copy.content.text2}</small>
    </a>

    <nav class="desktop-nav" aria-label="Fő navigáció">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-phone" href={practice.phoneHref} aria-label={`Telefon: ${practice.phone}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.34 1.83.57 2.79.69A2 2 0 0 1 22 16.92z" />
      </svg>
      <span>{practice.phone}</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Menü megnyitása">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobil navigáció">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="button button-primary" href="#kapcsolat">{copy.content.button1}</a>
      </nav>
    </details>
  </div>
</header>
