---
import copy from "../content/site/FAQ.json";
const faqs = copy.faqs;
---

<section class="section section-soft" id="gyakori-kerdesek" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div>
      <p class="eyebrow">{copy.gyakori_kerdesek.eyebrow1}</p>
      <h2 id="faq-title">{copy.gyakori_kerdesek.heading1}</h2>
      <p>{copy.gyakori_kerdesek.paragraph1}</p>
      <a class="button button-primary faq-booking" href="#kapcsolat">{copy.gyakori_kerdesek.button1}</a>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details open={index === 0}>
          <summary>{faq.question}</summary>
          {faq.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </details>
      ))}
    </div>
  </div>
</section>
